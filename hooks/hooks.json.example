{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__PLUGIN_DIR__/hooks/session-start-hook.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "__PLUGIN_DIR__/hooks/pre-tool-use-gate.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
